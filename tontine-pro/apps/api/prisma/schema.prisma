// Schéma de base de données — fidèle au document "Schéma back-end" du dossier projet.
// PostgreSQL, montants en FCFA (entiers), grand livre en écritures seules.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TontineStatus {
  draft
  active
  completed
  cancelled
}

enum TontineKind {
  rotating
  rotating_lottery
}

enum MemberRole {
  president
  treasurer
  member
}

enum MemberStatus {
  invited
  active
  left
  removed
}

enum RoundStatus {
  planned
  open
  complete
  closed
  payout_pending
  paid_out
  archived
}

enum ContributionStatus {
  due
  pending
  paid
  late
  waived
}

enum PaymentDirection {
  in
  out
}

enum PaymentStatus {
  initiated
  pending
  succeeded
  failed
  expired
  refunded
}

model User {
  id          String   @id @default(uuid())
  phone       String   @unique
  fullName    String   @map("full_name")
  language    String   @default("fr")
  momoNumber  String?  @map("momo_number")
  momoOperator String? @map("momo_operator")
  pinHash     String?  @map("pin_hash")
  status      String   @default("active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  createdTontines Tontine[]      @relation("TontineCreator")
  memberships     Membership[]
  auditEntries    AuditLog[]
  otpCodes        OtpCode[]
  notifications   Notification[]

  @@map("users")
}

model OtpCode {
  id        String   @id @default(uuid())
  phone     String
  codeHash  String   @map("code_hash")
  expiresAt DateTime @map("expires_at")
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone])
  @@map("otp_codes")
}

model Tontine {
  id                 String        @id @default(uuid())
  name               String
  description        String?
  kind               TontineKind   @default(rotating)
  contributionAmount BigInt        @map("contribution_amount")
  frequency          String // weekly | biweekly | monthly
  startDate          DateTime      @map("start_date")
  maxMembers          Int          @map("max_members")
  gracePeriodHours   Int           @default(24) @map("grace_period_hours")
  penaltyRule        Json          @default("{}") @map("penalty_rule")
  solidarityFeePct   Float         @default(0) @map("solidarity_fee_pct")
  orderMode          String        @default("lottery") @map("order_mode") // lottery | manual | vote
  timezone           String        @default("Africa/Abidjan")
  status             TontineStatus @default(draft)
  createdBy          String        @map("created_by")
  creator            User          @relation("TontineCreator", fields: [createdBy], references: [id])
  createdAt          DateTime      @default(now()) @map("created_at")
  startedAt          DateTime?     @map("started_at")

  memberships  Membership[]
  rounds       Round[]
  invitations  Invitation[]
  auditEntries AuditLog[]
  ledgerEntries LedgerEntry[]

  @@map("tontines")
}

model Membership {
  id               String       @id @default(uuid())
  tontineId        String       @map("tontine_id")
  tontine          Tontine      @relation(fields: [tontineId], references: [id])
  userId           String       @map("user_id")
  user             User         @relation(fields: [userId], references: [id])
  role             MemberRole   @default(member)
  status           MemberStatus @default(invited)
  joinedAt         DateTime?    @map("joined_at")
  acceptedRulesAt  DateTime?    @map("accepted_rules_at")
  rotationPosition Int?         @map("rotation_position")

  beneficiaryRounds Round[]         @relation("RoundBeneficiary")
  contributions     Contribution[]
  payouts           Payout[]

  @@unique([tontineId, userId])
  @@map("memberships")
}

model Invitation {
  id          String    @id @default(uuid())
  tontineId   String    @map("tontine_id")
  tontine     Tontine   @relation(fields: [tontineId], references: [id])
  token       String    @unique
  phone       String? // invitation nominative optionnelle
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")

  @@map("invitations")
}

model Round {
  id                       String      @id @default(uuid())
  tontineId                String      @map("tontine_id")
  tontine                  Tontine     @relation(fields: [tontineId], references: [id])
  roundNumber              Int         @map("round_number")
  beneficiaryMembershipId  String      @map("beneficiary_membership_id")
  beneficiary              Membership  @relation("RoundBeneficiary", fields: [beneficiaryMembershipId], references: [id])
  dueDate                  DateTime    @map("due_date")
  potAmount                BigInt      @map("pot_amount")
  status                   RoundStatus @default(planned)
  openedAt                 DateTime?   @map("opened_at")
  closedAt                 DateTime?   @map("closed_at")

  contributions Contribution[]
  payout        Payout?
  ledgerEntries LedgerEntry[]

  @@unique([tontineId, roundNumber])
  @@unique([tontineId, beneficiaryMembershipId])
  @@map("rounds")
}

model Contribution {
  id             String              @id @default(uuid())
  roundId        String              @map("round_id")
  round          Round               @relation(fields: [roundId], references: [id])
  membershipId   String              @map("membership_id")
  membership     Membership          @relation(fields: [membershipId], references: [id])
  amountDue      BigInt              @map("amount_due")
  amountPaid     BigInt              @default(0) @map("amount_paid")
  penaltyAmount  BigInt              @default(0) @map("penalty_amount")
  status         ContributionStatus  @default(due)
  paidAt         DateTime?           @map("paid_at")
  waivedReason   String?             @map("waived_reason")

  payments Payment[]

  @@unique([roundId, membershipId])
  @@index([status, roundId])
  @@map("contributions")
}

model Payment {
  id              String           @id @default(uuid())
  direction       PaymentDirection
  contributionId  String?          @map("contribution_id")
  contribution    Contribution?    @relation(fields: [contributionId], references: [id])
  provider        String           @default("simulated")
  providerRef     String?          @map("provider_ref")
  idempotencyKey  String           @unique @map("idempotency_key")
  operator        String?
  amount          BigInt
  fee             BigInt           @default(0)
  status          PaymentStatus    @default(initiated)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  payout Payout?
  ledgerEntries LedgerEntry[]

  @@unique([provider, providerRef])
  @@map("payments")
}

model Payout {
  id                       String     @id @default(uuid())
  roundId                  String     @unique @map("round_id")
  round                    Round      @relation(fields: [roundId], references: [id])
  beneficiaryMembershipId  String     @map("beneficiary_membership_id")
  beneficiary              Membership @relation(fields: [beneficiaryMembershipId], references: [id])
  paymentId                String?    @unique @map("payment_id")
  payment                  Payment?   @relation(fields: [paymentId], references: [id])
  amount                   BigInt
  attempts                 Int        @default(0)
  status                   String     @default("pending") // pending|sent|confirmed|failed

  @@map("payouts")
}

model WebhookEvent {
  id          String    @id @default(uuid())
  provider    String
  eventId     String    @map("event_id")
  payload     Json
  receivedAt  DateTime  @default(now()) @map("received_at")
  processedAt DateTime? @map("processed_at")

  @@unique([provider, eventId])
  @@map("webhook_events")
}

model LedgerEntry {
  id        BigInt   @id @default(autoincrement())
  txId      String   @map("tx_id")
  tontineId String   @map("tontine_id")
  tontine   Tontine  @relation(fields: [tontineId], references: [id])
  roundId   String?  @map("round_id")
  round     Round?   @relation(fields: [roundId], references: [id])
  paymentId String?  @map("payment_id")
  payment   Payment? @relation(fields: [paymentId], references: [id])
  account   String
  debit     BigInt   @default(0)
  credit    BigInt   @default(0)
  reason    String
  createdAt DateTime @default(now()) @map("created_at")

  @@index([txId])
  @@map("ledger_entries")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  tontineId String?  @map("tontine_id")
  tontine   Tontine? @relation(fields: [tontineId], references: [id])
  actorId   String?  @map("actor_id")
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  details   Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_log")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  user      User      @relation(fields: [userId], references: [id])
  type      String
  title     String
  body      String
  data      Json      @default("{}")
  channel   String    @default("in_app") // in_app|push|sms|whatsapp (simulés)
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([userId, createdAt])
  @@map("notifications")
}
