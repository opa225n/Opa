DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tontine?schema=public"
PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
# En dev/staging uniquement : simule SMS/paiement sans prestataire réel (cf. TRD §environnements).
SIMULATE_PROVIDERS=true
OTP_DEV_ECHO=true
