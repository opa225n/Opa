            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cle-c1",
              "leftValue": "={{ $json.cle_valide }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
