    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const d = $('Code_ParserReponseIA').item.json;\nconst msgEntrant = $('Code_ExtraireEvenement').item.json;\n\nlet texte;\nif (d.creer_commande) {\n  const c = d.details_commande || {};\n  const lignes = [\n    'Nouvelle commande de ' + msgEntrant.wa_id + ' :',\n    (c.produit || '?') + (c.quantite ? ' x ' + c.quantite : ''),\n  ];\n  if (c.adresse) lignes.push('Livraison : ' + c.adresse);\n  texte = lignes.join('\\n');\n} else {\n  texte = [\n    msgEntrant.wa_id + ' a besoin de vous.',\n    'Demande : ' + (msgEntrant.texte || '(message non texte)'),\n    'Raison : ' + (d.raison_transfert || 'transfert demande'),\n  ].join('\\n');\n}\n\nconst corps_envoi = JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: $('Postgres_TrouverCommerce').item.json.numero_patron,\n  type: 'text',\n  text: { body: texte },\n});\n\nreturn { texte_alerte: texte, corps_envoi };"
      },
