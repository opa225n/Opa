    {
      "parameters": {
        "width": 340,
        "height": 220,
        "content": "## Appel Claude\n\n`ANTHROPIC_MODEL` (variable d'environnement) : partir d'un modele rapide/economique (ex. claude-haiku), puis ajuster apres le jeu de questions du TRD §11 si le francais ivoirien familier pose probleme (TRD §3, §6). `max_tokens: 700` est un depart prudent a ajuster selon le cout mesure (TRD §12).",
        "color": 5
      },
      "id": "sn4",
      "name": "Note - IA",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        3440,
        40
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const r = $('Postgres_TraiterMessageEntrant').item.json.resultat;\nconst msgEntrant = $('Code_ExtraireEvenement').item.json;\nconst ficheTexte = r.fiche_contenu || '';\nconst resp = $json;\n\nlet ai = null;\ntry {\n  const blocs = resp.content || [];\n  const toolUse = blocs.find(function (b) { return b.type === 'tool_use' && b.name === 'repondre_client'; });\n  if (toolUse) ai = toolUse.input;\n} catch (e) { /* ai reste null */ }\n\nlet appelEnErreur = false;\nif (!ai || resp.error) {\n  appelEnErreur = true;\n  ai = {\n    texte: \"Merci, je m'en occupe. Un instant s'il vous plait, l'equipe va vous repondre.\",\n    intention: 'humain',\n    besoin_humain: true,\n    raison_besoin_humain: 'erreur_ia',\n    champs_commande: {},\n    commande_complete: false,\n  };\n}\nai.champs_commande = ai.champs_commande || {};\n\nfunction extrairePrix(texte) {\n  const trouves = new Set();\n  const re = /([0-9][0-9\\s]{2,})\\s*(FCFA|F\\s?CFA|francs)/gi;\n  let m;\n  while ((m = re.exec(texte || '')) !== null) {\n    trouves.add(m[1].replace(/\\s/g, ''));\n  }\n  return trouves;\n}\n\nconst prixFiche = extrairePrix(ficheTexte);\nconst prixReponse = extrairePrix(ai.texte);\nlet prixInvente = false;\nfor (const p of prixReponse) {\n  if (!prixFiche.has(p)) { prixInvente = true; break; }\n}\n\nif (prixInvente) {\n  ai.texte = \"Je verifie ce prix avec l'equipe et je vous confirme tres vite.\";\n  ai.besoin_humain = true;\n  ai.raison_besoin_humain = 'prix_non_confirme';\n  ai.intention = 'humain';\n}\n\nconst etatActuel = r.etat;\nconst texteClientBrut = String(msgEntrant.texte || '').trim().toLowerCase();\nconst estOui = ['oui', 'ok', \"d'accord\", 'daccord', 'confirme', 'confirmé'].includes(texteClientBrut);\nconst estAnnulation = ['non', 'annule', 'annuler', 'annulation'].includes(texteClientBrut);\n\nlet nouvelEtat = etatActuel;\nlet creerCommande = false;\nlet contexteMaj = Object.assign({}, (r.contexte || {}), ai.champs_commande);\n\nif (ai.besoin_humain) {\n  nouvelEtat = 'humain';\n} else if (etatActuel === 'confirmation') {\n  if (estOui) {\n    nouvelEtat = 'termine';\n    creerCommande = true;\n  } else if (estAnnulation) {\n    nouvelEtat = 'menu';\n    contexteMaj = {};\n  } else {\n    nouvelEtat = 'commande';\n  }\n} else if (ai.intention === 'commande') {\n  nouvelEtat = ai.commande_complete ? 'confirmation' : 'commande';\n} else {\n  nouvelEtat = 'menu';\n}\n\nconst creerEvenementTransfert = (nouvelEtat === 'humain');\nconst creerEvenementInjection = (ai.intention === 'injection');\n\nconst corps_envoi_client = JSON.stringify({\n  messaging_product: 'whatsapp',\n  to: $('Code_ExtraireEvenement').item.json.wa_id,\n  type: 'text',\n  text: { body: ai.texte },\n});\n\nreturn {\n  texte_final: ai.texte,\n  nouvel_etat: nouvelEtat,\n  contexte_maj: nouvelEtat === 'termine' ? {} : contexteMaj,\n  creer_commande: creerCommande,\n  details_commande: creerCommande ? ai.champs_commande : null,\n  creer_evenement_transfert: creerEvenementTransfert,\n  raison_transfert: ai.raison_besoin_humain || (appelEnErreur ? 'erreur_ia' : null),\n  creer_evenement_injection: creerEvenementInjection,\n  besoin_alerte_patron: creerEvenementTransfert || creerCommande,\n  appel_ia_en_erreur: appelEnErreur,\n  corps_envoi_client: corps_envoi_client,\n};"
      },
