        "language": "javaScript",
        "jsCode": "const body = $json.body || {};\nconst entry = (body.entry || [])[0] || {};\nconst change = (entry.changes || [])[0] || {};\nconst value = change.value || {};\nconst msg = (value.messages || [])[0];\n\nif (!msg) {\n  return { est_message: false };\n}\n\nconst contact = (value.contacts || [])[0] || {};\n\nreturn {\n  est_message: true,\n  phone_number_id: value.metadata ? value.metadata.phone_number_id : null,\n  wa_id: msg.from,\n  nom_profil: contact.profile ? contact.profile.name : null,\n  id_meta: msg.id,\n  type_message: msg.type,\n  texte: (msg.type === 'text' && msg.text) ? msg.text.body : null,\n  est_texte: msg.type === 'text',\n  horodatage: msg.timestamp,\n};"
      },
