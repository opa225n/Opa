# Copier ce fichier en ".env" et remplir chaque valeur. Ne jamais committer ".env".
# Référence : TRD section 8 (sécurité) — aucun secret dans un flux exporté ni dans Git.

# --- PostgreSQL ---
POSTGRES_DB=whatsapp_agence
POSTGRES_USER=admin_agence
POSTGRES_PASSWORD=change_moi_mot_de_passe_long_et_aleatoire
# Rôle applicatif restreint par RLS (migration 004) ; mot de passe différent du précédent.
POSTGRES_APP_USER=flux_n8n
POSTGRES_APP_PASSWORD=change_moi_aussi_different

# --- n8n ---
N8N_HOST=votre-domaine.com
N8N_PROTOCOL=https
WEBHOOK_URL=https://votre-domaine.com/
# Générer avec : openssl rand -hex 32
N8N_ENCRYPTION_KEY=
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_moi
TZ=Africa/Abidjan

# --- Meta WhatsApp Cloud API (Développeurs Meta > votre app > WhatsApp) ---
# Jeton de vérification que VOUS choisissez et que vous recopiez dans la config du webhook Meta.
META_VERIFY_TOKEN=choisissez_une_valeur_secrete
# Secret de l'application Meta (pour vérifier la signature X-Hub-Signature-256 des appels entrants).
META_APP_SECRET=
# Jeton d'accès permanent (System User) à l'API Graph WhatsApp.
META_WHATSAPP_TOKEN=
META_GRAPH_API_VERSION=v21.0

# --- API Claude (Anthropic) ---
ANTHROPIC_API_KEY=
# Modèle rapide/économique recommandé pour le MVP (TRD section 3) ; ajustez après test
# sur le jeu de questions (TRD section 11) si le français ivoirien familier pose problème.
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Agence ---
# Clé secrète pour protéger le workflow admin interne (03-api-interne.json).
ADMIN_API_KEY=choisissez_une_cle_longue_et_aleatoire
# Numéro WhatsApp (format E.164) de l'agence, utilisé pour les alertes de supervision
# (erreurs de flux, panne du webhook) — distinct du numéro du patron du commerce.
AGENCE_ALERT_WHATSAPP=

# --- Conformité ---
# Durée de conservation des messages avant purge automatique (TRD/Schéma section 8-9).
RETENTION_JOURS=90
