# ---------------------------------------------------------------------------
# Tontine CI — variables d'environnement
# Copiez ce fichier en .env et renseignez vos propres valeurs. Ne jamais committer .env.
# ---------------------------------------------------------------------------

# Base de données PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/tontine_ci?schema=public"

# Authentification (Auth.js / NextAuth v5)
# Générez une valeur aléatoire forte, ex: `openssl rand -base64 32`
AUTH_SECRET="changez-moi-avec-une-valeur-aleatoire-forte"

# Nom de l'application (configurable, affiché dans l'interface)
NEXT_PUBLIC_APP_NAME="Tontine CI"

# --- Intégrations externes (toutes optionnelles, désactivées si absentes) ---

# SMS (vérification de numéro, rappels) — exemple générique, à adapter au prestataire choisi
# SMS_PROVIDER_API_KEY=
# SMS_PROVIDER_SENDER_ID=

# E-mail (notifications) — exemple générique (ex: Resend, SendGrid, SMTP)
# EMAIL_PROVIDER_API_KEY=
# EMAIL_FROM_ADDRESS="no-reply@votre-domaine.com"

# WhatsApp Business API (notifications) — nécessite un compte WhatsApp Business officiel
# WHATSAPP_API_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=

# Mobile Money — tant qu'aucune de ces variables n'est renseignée pour un prestataire donné,
# ce prestataire fonctionne en mode démonstration (aucun transfert réel). Voir la section
# "Intégrations externes" du README pour le détail de chaque étape d'activation.
# ORANGE_MONEY_API_KEY=
# ORANGE_MONEY_MERCHANT_ID=
# MTN_MOMO_API_KEY=
# MTN_MOMO_SUBSCRIPTION_KEY=
# MOOV_MONEY_API_KEY=
# WAVE_API_KEY=

# Secret de signature des webhooks de paiement (HMAC-SHA256 générique — à remplacer par le
# schéma de signature réel de chaque prestataire avant mise en production, voir
# src/lib/payments/verify-signature.ts). Sans cette variable, tout webhook est rejeté comme
# non signé (fail-safe).
# PAYMENT_WEBHOOK_SIGNING_SECRET=
